# ================================================================
# DizpatchGO — Apache Web Server Security Configuration (.htaccess)
# ================================================================

# 1. Prevent directory browsing/indexing
Options -Indexes

# 2. Block direct web access to sensitive configuration and system files
<FilesMatch "^(config\.php|\.env|\.git.*|composer\.(json|lock)|.*\.log|.*\.ini)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# 3. Security Headers
<IfModule mod_headers.c>
    # Prevent MIME-type sniffing
    Header always set X-Content-Type-Options "nosniff"
    # Clickjacking protection
    Header always set X-Frame-Options "SAMEORIGIN"
    # XSS filter
    Header always set X-XSS-Protection "1; mode=block"
    # Referrer policy
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# 4. Default character set
AddDefaultCharset UTF-8

# 5. Compress text responses when Apache's compression modules are available.
# WebP/PNG images and WOFF2 fonts are already compressed; leave them alone.
<IfModule mod_deflate.c>
    <IfModule mod_filter.c>
        AddOutputFilterByType DEFLATE text/html text/css text/plain text/javascript application/javascript application/json application/ld+json application/xml text/xml image/svg+xml
    </IfModule>
</IfModule>

# 6. Reuse static assets for 30 days, while revalidating HTML on each visit.
# When changing an asset, change its filename or its ?v= URL version as well.
# CSS/JS already use versioned URLs; optimized images use a content-hash version.
# Do not mark unversioned assets immutable or apply public caching to PHP forms.
<IfModule mod_headers.c>
    <FilesMatch "\.(?:avif|gif|ico|jpe?g|png|svg|webp|css|js|woff2?|ttf|otf)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>
    <FilesMatch "\.html?$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
</IfModule>
